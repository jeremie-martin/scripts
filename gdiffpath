#!/usr/bin/env bash

# gdiffpath - List relative paths of modified non-binary files in git
# Usage:
#   gdiffpath               -> modified files since last commit (unstaged + staged)
#   gdiffpath -s            -> staged files only
#   gdiffpath <commit>      -> files modified by a given commit
#   gdiffpath <range>       -> files modified across a commit range (e.g. HEAD~3..HEAD)

set -e

STAGED=0
TARGET=""

# Parse options
while getopts "s" opt; do
  case $opt in
    s) STAGED=1 ;;
    *) echo "Usage: $0 [-s] [commit|range]" >&2; exit 1 ;;
  esac
done
shift $((OPTIND -1))

# Remaining argument (if any) is a commit or range
if [ $# -gt 0 ]; then
  TARGET="$1"
fi

if [ -n "$TARGET" ]; then
  if [[ "$TARGET" == *..* ]]; then
    # Commit range
    FILES=$(git diff --name-only "$TARGET")
  else
    # Single commit
    FILES=$(git diff-tree --no-commit-id --name-only -r "$TARGET")
  fi
elif [ $STAGED -eq 1 ]; then
  # Show staged changes (against HEAD)
  FILES=$(git diff --cached --name-only)
else
  # Show changes since last commit (unstaged + staged compared to HEAD)
  FILES=$(git diff HEAD --name-only)
fi

# Filter out binary files
for f in $FILES; do
  if [ -f "$f" ]; then
    if ! git check-attr --all -- "$f" | grep -q "binary"; then
      echo "$f"
    fi
  else
    # Deleted or renamed files: check via numstat
    if ! git diff --numstat ${TARGET:-HEAD} -- "$f" 2>/dev/null | grep -q "^-"; then
      echo "$f"
    fi
  fi
done
