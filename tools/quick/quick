#!/usr/bin/env python3
"""Scaffold a throwaway project under ~/prog/quick and print its path."""

import argparse
import re
import subprocess
import sys
from pathlib import Path

BASE_DIR = Path.home() / "prog" / "quick"
TYPES = ("python", "node", "cpp", "empty")

GITIGNORE = {
    "python": "__pycache__/\n*.pyc\n.venv/\n.env\ndist/\n*.egg-info/\n",
    "node": "node_modules/\ndist/\n*.log\n.env\n",
    "cpp": "build/\n*.o\n*.out\n",
    "empty": ".env\n",
}


def _write(path: Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)


def _scaffold_python(dest: Path, name: str) -> None:
    # uv is the project's standard toolchain; let it lay out the project offline.
    subprocess.run(["uv", "init", "--vcs", "none", "--name", name, str(dest)], check=True, stdout=subprocess.DEVNULL)


def _scaffold_node(dest: Path, name: str) -> None:
    _write(
        dest / "package.json",
        f'{{\n  "name": "{name}",\n  "version": "0.1.0",\n  "type": "module",\n'
        '  "scripts": {\n'
        '    "dev": "tsx src/index.ts",\n'
        '    "build": "tsc"\n'
        "  }\n}\n",
    )
    _write(
        dest / "tsconfig.json",
        '{\n  "compilerOptions": {\n'
        '    "target": "ES2022",\n'
        '    "module": "ESNext",\n'
        '    "moduleResolution": "bundler",\n'
        '    "strict": true,\n'
        '    "outDir": "dist",\n'
        '    "esModuleInterop": true,\n'
        '    "skipLibCheck": true\n'
        '  },\n  "include": ["src"]\n}\n',
    )
    _write(dest / "src" / "index.ts", 'console.log("hello from ' + name + '");\n')


def _scaffold_cpp(dest: Path, name: str) -> None:
    _write(
        dest / "CMakeLists.txt",
        f"cmake_minimum_required(VERSION 3.20)\nproject({name} CXX)\n\n"
        "set(CMAKE_CXX_STANDARD 20)\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\n\n"
        f"add_executable({name} src/main.cpp)\n",
    )
    _write(
        dest / "src" / "main.cpp",
        f'#include <iostream>\n\nint main() {{\n    std::cout << "hello from {name}" << std::endl;\n    return 0;\n}}\n',
    )


SCAFFOLDS = {
    "python": _scaffold_python,
    "node": _scaffold_node,
    "cpp": _scaffold_cpp,
    "empty": lambda dest, name: None,
}


def create(name: str, flavour: str, base: Path, git: bool, force: bool) -> Path:
    dest = (base.expanduser() / name).resolve()
    if dest.exists() and not force:
        raise FileExistsError(f"Refusing to overwrite existing directory: {dest} (use --force)")
    dest.mkdir(parents=True, exist_ok=True)
    try:
        SCAFFOLDS[flavour](dest, name)
    except (OSError, subprocess.CalledProcessError) as exc:
        raise RuntimeError(f"Scaffold step failed: {exc}") from exc

    # README + .gitignore unless the scaffolder already supplied them (uv writes a README).
    readme = dest / "README.md"
    if not readme.exists():
        _write(readme, f"# {name}\n")
    gitignore = dest / ".gitignore"
    if not gitignore.exists():
        _write(gitignore, GITIGNORE[flavour])

    if git and not (dest / ".git").exists():
        try:
            subprocess.run(["git", "init", "-q", str(dest)], check=True)
        except (OSError, subprocess.CalledProcessError) as exc:
            raise RuntimeError(f"Git initialization failed: {exc}") from exc
    return dest


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="quick", description=__doc__)
    parser.add_argument("name", nargs="?", default="scratch", help="project name; becomes the directory name (default: scratch)")
    parser.add_argument("type", nargs="?", default="empty", help=f"{', '.join(TYPES)} (default: empty)")
    parser.add_argument("--base", type=Path, default=BASE_DIR, help="parent directory (default: ~/prog/quick)")
    parser.add_argument("--git", action=argparse.BooleanOptionalAction, default=True, help="initialise a git repository")
    parser.add_argument("-f", "--force", action="store_true", help="reuse the directory if it already exists")
    args = parser.parse_args(argv)

    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", args.name):
        print("Project name must start with a letter and contain only letters, digits, underscores, or hyphens.", file=sys.stderr)
        return 2
    flavour = args.type.lower()
    if flavour not in TYPES:
        print(f"Unknown type '{args.type}'. Choose one of: {', '.join(TYPES)}.", file=sys.stderr)
        return 2
    try:
        dest = create(args.name, flavour, args.base, args.git, args.force)
    except (FileExistsError, RuntimeError) as error:
        print(error, file=sys.stderr)
        return 1
    print(f"Created {flavour} project at {dest}", file=sys.stderr)
    # Bare path on stdout so it's usable in a subshell, e.g. cd "$(quick foo)".
    print(dest)
    return 0


if __name__ == "__main__":
    sys.exit(main())
